# KAMPS environment (copy to .env and fill what you have)

# PostgreSQL/SQLite connection used by Prisma (scaffolded db)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ReliefWeb v2 API: appname pending review (requested 2026-09-27 via the
# official form; OCHA replies within two business days).
# When the approval email arrives, set it and run:
#   node scripts/ingest-reliefweb.mjs
RELIEFWEB_APPNAME=

# ACLED: register once from a normal browser (datacenter IPs are
# Cloudflare-blocked): https://acleddata.com/register, confirm the email,
# then set both values and run:
#   node scripts/ingest-acled.mjs
ACLED_EMAIL=
ACLED_KEY=
