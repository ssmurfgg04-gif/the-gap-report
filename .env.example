# KAMPS environment (copy to .env and fill what you have)

# PostgreSQL/SQLite connection used by Prisma (scaffolded db)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ACLED myACLED account. OAuth credentials for:
#   1. POST /oauth/token (programmatic, 24h access token, 14d refresh)
#   2. POST /user/login?_format=json (session cookie for downloads)
# The Open tier reaches the weekly aggregated Africa xlsx (all 47 Kenya
# counties, Admin 1 x week x event type, refreshed Mondays). Event-level
# REST (/api/acled/read) unlocks at Research Partner tier - the ingest
# script probes it first and falls back to the aggregate file.
# Refresh: ACLED_EMAIL=... ACLED_PASSWORD=... node scripts/ingest-acled.mjs
ACLED_EMAIL=
ACLED_PASSWORD=

# ReliefWeb v2 API: appname requested 2026-09-27 via the official form,
# OCHA replies within two business days. Once approved, ALSO set it as the
# RELIEFWEB_APPNAME repo secret so the weekly GitHub Action picks it up:
#   RELIEFWEB_APPNAME=... node scripts/ingest-reliefweb.mjs
RELIEFWEB_APPNAME=

# Keyless weekly feeds (no credentials needed, run from the GitHub Action or
# manually):
#   node scripts/news-watch.mjs            # Google News RSS + Bing News + KNCHR index
#   node scripts/ingest-gdelt.mjs          # GDELT DOC 2.0 media volume
#   node scripts/ingest-missingvoices.mjs  # Missing Voices weekly refresh
#   bun scripts/weekly-digest.mjs          # markdown digest (also runs in CI)
